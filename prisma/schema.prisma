generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { OWNER DEVELOPER DESIGNER FINANCE QA }
enum ProjectStatus { ACTIVE ARCHIVED }
enum SpecStatus { DRAFT IN_REVIEW APPROVED SUPERSEDED }
enum TaskStatus { BACKLOG READY IN_PROGRESS CODE_REVIEW QA DONE }
enum Priority { LOW MEDIUM HIGH URGENT }
enum BugSeverity { LOW MEDIUM HIGH CRITICAL }
enum BugStatus { OPEN IN_PROGRESS RESOLVED VERIFIED }
enum TestStatus { PENDING PASSED FAILED }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  createdAt DateTime @default(now())
  organizationMemberships OrganizationMember[]
  projectMemberships ProjectMember[]
  assignedTasks Task[]
  activity ActivityLog[]
}

model Organization {
  id String @id @default(cuid())
  name String
  createdById String
  createdAt DateTime @default(now())
  memberships OrganizationMember[]
  projects Project[]
}

model OrganizationMember {
  id String @id @default(cuid())
  organizationId String
  userId String
  role Role
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
}

model Project {
  id String @id @default(cuid())
  organizationId String
  name String
  description String @default("")
  status ProjectStatus @default(ACTIVE)
  stack String @default("Next.js · PostgreSQL · Tailwind")
  repositoryUrl String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  modules Module[]
  tasks Task[]
  bugs Bug[]
  decisions Decision[]
  activity ActivityLog[]
}

model ProjectMember {
  id String @id @default(cuid())
  projectId String
  userId String
  role Role
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
}

model Module {
  id String @id @default(cuid())
  projectId String
  name String
  position Int
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages Page[]
  @@unique([projectId, position])
}

model Page {
  id String @id @default(cuid())
  moduleId String
  name String
  route String
  position Int
  purpose String @default("")
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sections Section[]
  @@unique([moduleId, position])
}

model Section {
  id String @id @default(cuid())
  pageId String
  title String
  position Int
  specification Json
  specStatus SpecStatus @default(DRAFT)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  features Feature[]
  tasks Task[]
  @@unique([pageId, position])
}

model Feature {
  id String @id @default(cuid())
  sectionId String
  title String
  description String
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Task {
  id String @id @default(cuid())
  projectId String
  sectionId String?
  title String
  status TaskStatus @default(BACKLOG)
  blockedReason String?
  assigneeId String?
  priority Priority @default(MEDIUM)
  description String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id])
  assignee User? @relation(fields: [assigneeId], references: [id])
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependedOnBy TaskDependency[] @relation("DependsOn")
  testCases TestCase[]
  bugs Bug[]
  githubLink GithubLink?
}

model TaskDependency {
  taskId String
  dependsOnTaskId String
  task Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  @@id([taskId, dependsOnTaskId])
}

model TestCase {
  id String @id @default(cuid())
  taskId String
  title String
  steps String
  expectedResult String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runs TestRun[]
}

model TestRun {
  id String @id @default(cuid())
  testCaseId String
  status TestStatus
  testedBy String
  notes String @default("")
  createdAt DateTime @default(now())
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}

model Bug {
  id String @id @default(cuid())
  projectId String
  taskId String?
  title String
  severity BugSeverity
  status BugStatus @default(OPEN)
  reproductionSteps String
  expectedResult String @default("")
  actualResult String @default("")
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id])
}

model Decision {
  id String @id @default(cuid())
  projectId String
  title String
  rationale String
  decidedBy String
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id String @id @default(cuid())
  projectId String
  actorId String?
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])
  @@index([projectId, createdAt])
}

model GithubLink {
  id String @id @default(cuid())
  taskId String @unique
  branch String
  prUrl String?
  commitSha String?
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
